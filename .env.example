# Copy this file to apps/api/.env for local development.
# Never commit a real .env file or real API keys.

APP_NAME=ECHO
ENVIRONMENT=local
LOG_LEVEL=INFO

# SimulationProfile controls population scale.
# dev  -> 10-20 agents (fast local iteration, debugging)
# mvp  -> 100 agents (target MVP demonstration scale)
#
# Defaults to mvp so a fresh checkout matches the authoritative MVP/100
# configuration everywhere (health, /world, /simulation/state all derive
# population from this one setting). Switch to `dev` only for fast local
# iteration, and expect every endpoint -- not just /api/health -- to
# reflect the smaller population when you do.
SIMULATION_PROFILE=mvp

# Default seed used when a simulation is created without an explicit seed.
DEFAULT_SEED=12345

# Matches docker-compose.yml's postgres service credentials.
DATABASE_URL=postgresql+psycopg2://echo:echo@localhost:5432/echo

# Matches docker-compose.yml's redis service.
REDIS_URL=redis://localhost:6379/0

# LLM provider config. Not yet used by any code in Phase 0 -- the
# LLMStrategy that consumes these is implemented in Phase 9.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=not-configured
LLM_MAX_CALLS_PER_TICK=5
